# Non-secret + secret settings for willow-bot.
# Lives at: $WILLOW_VAULT_BOX/secrets/willow-bot.env  (mode 600)
# PEM lives at: $WILLOW_VAULT_BOX/secrets/willow-bot.pem  (mode 600)
#
# Never commit this file. credentials.py reads it; checkout .env is not the
# source of truth.

GITHUB_APP_ID=
# Optional; GitHub now accepts Client ID as JWT iss (same as App ID for tokens)
# GITHUB_APP_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
# Optional override; default is $WILLOW_VAULT_BOX/secrets/willow-bot.pem
# GITHUB_APP_PRIVATE_KEY_PATH=

BOT_HOST=127.0.0.1
BOT_PORT=9000
WEBHOOK_PUBLIC_URL=
FRANK_MODE=
