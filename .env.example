GITHUB_APP_ID=
# Prefer vault: leave unset and put the PEM at
#   $WILLOW_VAULT_BOX/secrets/willow-bot.pem
# Override only for tests:
# GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
FRANK_MODE=

# Local listener. Pangolin should forward the public webhook route here.
BOT_HOST=127.0.0.1
BOT_PORT=9000
WEBHOOK_PUBLIC_URL=https://bot.example.com

# Secrets source of truth: $WILLOW_VAULT_BOX/secrets/ (see INSTALL.md).
# This checkout .env is optional overrides only.
