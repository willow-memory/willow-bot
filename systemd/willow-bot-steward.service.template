[Unit]
Description=Willow steward tick loop — PR watch, curated heartbeat, gitsync sweep
Documentation=https://github.com/willow-memory/willow-bot
After=network-online.target willow-bot.service
Wants=network-online.target

[Service]
Type=simple
# `@…@` placeholders are substituted by scripts/install-service.sh at install
# time (`scripts/install-service.sh willow-bot-steward`). A fresh clone must
# NOT commit a rendered service file.
Environment=PATH=@VENV_BIN@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=WILLOW_HOME=@VAULT_BOX@
Environment=WILLOW_VAULT_BOX=@VAULT_BOX@
# The tick's act half goes through willow-mcp: the curated heartbeat and the
# gitsync sweep (git_pull_execute under the App's token, FRANK receipt). With
# this on, merge.py's host gh/pip -e sync is off unless
# WILLOW_BOT_STEWARD_HOST_SYNC says otherwise (steward/config.py).
Environment=WILLOW_BOT_MCP=1
# The willow-mcp the steward spawns over stdio. The operator-box venv is the
# one whose editable install tracks the fleet checkout; override with
# WILLOW_BOT_MCP_COMMAND in the env file if it lives elsewhere.
# Quoted: systemd splits an unquoted Environment= value on spaces and kept
# only the python path on the first install (journal: "ignoring: -m",
# "ignoring: willow_mcp"), so the steward spawned a bare REPL as its server.
Environment="WILLOW_BOT_MCP_COMMAND=@VAULT_BOX@/venvs/willow-mcp/bin/python -m willow_mcp"
# The spawned server sees this unit's whole environment, as the prove-phase
# recipe in INSTALL.md sets it; the default forwards only WILLOW_*/PG* on top
# of the MCP SDK's minimal env, which drops anything else the env file
# carries (NESTOR_*, for one).
Environment=WILLOW_BOT_MCP_INHERIT_ENV=1
# The steward speaks to its spawned server as its OWN principal (sealed
# 163b9a70): app_id=willow-bot, never the human orchestrator seat.
#
# *** DO NOT re-render/reinstall this template (`scripts/install-service.sh
# willow-bot-steward`) until BOTH of these have landed: ***
#   1. willow-mcp packet 4326FDFE — the orchestrator-scoped verbs this tick
#      calls (gitsync_sweep, git_pull_execute, human_required_list/enqueue,
#      seal_drain, net_authority_drain, envelope_retire_sweep, ...) accept
#      willow-bot as a named second principal, each under its own
#      permission group — NOT WILLOW_HUMAN_ORCHESTRATOR.
#   2. mcp_apps/willow-bot/manifest.json exists (that packet's deliverable)
#      and is signed.
# Reinstalling this template before both land makes every one of those
# calls EPERM as willow-bot — the sweep, the seal drains, and the
# human_required queue all go dark, not just Grove.
#
# The CODE-LEVEL default (willow_bot/steward/config.py:app_id()) stays
# "willow" — main's existing behavior, unchanged — precisely so an
# ALREADY-INSTALLED unit (no WILLOW_BOT_MCP_APP_ID line, still carrying
# WILLOW_HUMAN_ORCHESTRATOR=1) keeps working exactly as it does today
# after a merge + pull + restart, no matter when this branch lands. The
# Environment= line below is what actually switches the identity; it
# takes effect only once THIS FILE is re-rendered and reinstalled — which
# is the one-time act to hold off on until both items above are true.
Environment=WILLOW_BOT_MCP_APP_ID=willow-bot
Environment=WILLOW_BOT_STEWARD_INTERVAL=300
# Non-secret overrides and the WILLOW_* the spawned server needs (PG, keyring,
# store root) come from the same env file the webhook unit reads.
EnvironmentFile=-@VAULT_BOX@/secrets/willow-bot.env
WorkingDirectory=@WORKDIR@
ExecStart=@VENV_BIN@/willow-bot-steward loop
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
