[Unit]
Description=Willow GitHub App webhook bot
Documentation=https://github.com/rudi193-cmd/willow-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/github/willow-bot/.env
WorkingDirectory=%h/github/willow-bot
ExecStart=%h/github/willow-bot/.venv/bin/uvicorn bot:app --host ${BOT_HOST} --port ${BOT_PORT}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
